# Variables d'environnement MonPlanFin (Vite). Copier en .env.local pour le dev.
# .env.local est gitignore. En prod, ces valeurs sont definies dans Vercel.

# Supabase (cle anon = publique, livree au client ; la RLS protege les donnees).
# Repli code sur les valeurs publiques si absentes -> dev/preview ne cassent pas.
VITE_SUPABASE_URL=https://ljezchpqqyxgehdwvnot.supabase.co
VITE_SUPABASE_ANON_KEY=

# Meta Pixel (tracking pubs) — repli sur l'ID en dur si absent.
VITE_META_PIXEL_ID=

# Sentry (monitoring) — si absent, Sentry ne s'initialise pas.
VITE_SENTRY_DSN=
