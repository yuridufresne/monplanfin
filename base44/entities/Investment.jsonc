{
  "name": "Investment",
  "type": "object",
  "properties": {
    "asset_name": {
      "type": "string",
      "description": "Nom complet de l'actif"
    },
    "symbol": {
      "type": "string",
      "description": "Symbole boursier (ticker)"
    },
    "asset_type": {
      "type": "string",
      "enum": [
        "action",
        "fnb",
        "fond_mutuel",
        "crypto",
        "obligations",
        "autre"
      ],
      "description": "Type d'actif"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "celi",
        "reer",
        "reee",
        "non_enregistre",
        "autre"
      ],
      "description": "Type de compte"
    },
    "quantity": {
      "type": "number",
      "description": "Nombre de parts d\u00e9tenues"
    },
    "purchase_date": {
      "type": "string",
      "format": "date",
      "description": "Date d'achat (ISO)"
    },
    "purchase_price": {
      "type": "number",
      "description": "Prix d'achat par part ($)"
    },
    "current_price": {
      "type": "number",
      "description": "Prix actuel par part ($)"
    },
    "current_value": {
      "type": "number",
      "description": "Valeur actuelle totale ($)"
    },
    "last_updated": {
      "type": "string",
      "description": "Derni\u00e8re mise \u00e0 jour des prix (timestamp ISO)"
    },
    "annual_return_pct": {
      "type": "number",
      "description": "Rendement annuel en %"
    },
    "ai_metadata": {
      "type": "string",
      "description": "R\u00e9sum\u00e9 contextuel pour l'IA (type d'actif, contexte macro, volatilit\u00e9...)"
    },
    "notes": {
      "type": "string",
      "description": "Notes personnelles"
    }
  },
  "required": [
    "asset_name",
    "asset_type",
    "quantity",
    "purchase_price"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}