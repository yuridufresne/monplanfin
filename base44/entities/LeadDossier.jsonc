{
  "name": "LeadDossier",
  "type": "object",
  "properties": {
    "besoins_principaux": {
      "description": "Les besoins principaux du client (multi-s\u00e9lection)",
      "items": {
        "enum": [
          "achat_immobilier",
          "refinancement_hypotheque",
          "protection_famille",
          "retraite_planification",
          "decaissement_retraite",
          "optimisation_fiscale",
          "placements_celi_reer_celiapp",
          "epargne_etudes_reee",
          "succession_testament",
          "consolidation_dettes",
          "autre"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "client_courriel": {
      "description": "Courriel du client (snapshot)",
      "format": "email",
      "type": "string"
    },
    "client_nom": {
      "description": "Nom du client (snapshot)",
      "type": "string"
    },
    "client_telephone": {
      "description": "T\u00e9l\u00e9phone du client (snapshot)",
      "type": "string"
    },
    "consentement_explicite": {
      "default": true,
      "description": "Le client a coch\u00e9 la case de consentement explicite au moment de la soumission",
      "type": "boolean"
    },
    "date_consentement": {
      "description": "Horodatage du consentement (Loi 25)",
      "format": "date-time",
      "type": "string"
    },
    "delai_action_libre": {
      "description": "Pr\u00e9cision libre sur le d\u00e9lai",
      "type": "string"
    },
    "meilleur_moment_contact": {
      "description": "Quand le client pr\u00e9f\u00e8re \u00eatre contact\u00e9",
      "enum": [
        "matin_semaine",
        "midi_semaine",
        "soir_semaine",
        "fin_de_semaine",
        "nimporte_quand"
      ],
      "type": "string"
    },
    "mode_contact_prefere": {
      "description": "Comment le client pr\u00e9f\u00e8re \u00eatre contact\u00e9",
      "enum": [
        "telephone",
        "courriel",
        "texto",
        "videoconference"
      ],
      "type": "string"
    },
    "notes_client": {
      "description": "Message libre du client lors de la soumission",
      "type": "string"
    },
    "notes_internes": {
      "description": "Notes internes (jamais visibles au client)",
      "type": "string",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "priorite_urgence": {
      "description": "\u00c0 quelle vitesse le client veut agir",
      "enum": [
        "tres_urgent",
        "urgent",
        "moyen",
        "exploration"
      ],
      "type": "string"
    },
    "snapshot_profil": {
      "description": "Copie fig\u00e9e de tout l'ABF du client au moment de la soumission",
      "type": "object"
    },
    "statut": {
      "default": "nouveau",
      "description": "Statut de traitement du dossier",
      "enum": [
        "nouveau",
        "vu",
        "contacte",
        "en_cours",
        "ferme_converti",
        "ferme_perdu"
      ],
      "type": "string"
    },
    "agent_assigne_courriel": {
      "description": "Courriel de l'agent \u00e0 qui le dossier est assign\u00e9 (vide = non assign\u00e9). Utilis\u00e9 par la RLS pour donner acc\u00e8s \u00e0 l'agent.",
      "format": "email",
      "type": "string",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "data.type_compte": "directeur"
              }
            }
          ]
        }
      }
    },
    "agent_assigne_nom": {
      "description": "Nom de l'agent assign\u00e9 (snapshot pour affichage)",
      "type": "string",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "data.type_compte": "directeur"
              }
            }
          ]
        }
      }
    },
    "date_assignation": {
      "description": "Horodatage de l'assignation du dossier \u00e0 l'agent",
      "format": "date-time",
      "type": "string",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "data.type_compte": "directeur"
              }
            }
          ]
        }
      }
    },
    "assigne_par_courriel": {
      "description": "Courriel de l'admin/directeur qui a effectu\u00e9 l'assignation (tra\u00e7abilit\u00e9)",
      "format": "email",
      "type": "string",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "data.type_compte": "directeur"
              }
            }
          ]
        }
      }
    },
    "historique": {
      "description": "Journal horodat\u00e9 des \u00e9v\u00e9nements du dossier : assignations, transferts, changements de statut, notes",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "assignation",
              "transfert",
              "statut",
              "note"
            ]
          },
          "de": {
            "type": "string",
            "description": "Ancienne valeur (statut ou agent)"
          },
          "a": {
            "type": "string",
            "description": "Nouvelle valeur (statut ou agent)"
          },
          "note": {
            "type": "string",
            "description": "Texte de la note (type=note)"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "par": {
            "type": "string",
            "description": "Courriel de l'auteur"
          }
        }
      },
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "data.type_compte": "agent"
              }
            },
            {
              "user_condition": {
                "data.type_compte": "directeur"
              }
            }
          ]
        }
      }
    },
    "derniere_activite_agent": {
      "description": "Horodatage de la derni\u00e8re action de l'agent sur ce dossier (statut ou note) \u2014 sert au calcul d'urgence 24 h",
      "format": "date-time",
      "type": "string",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "data.type_compte": "agent"
              }
            },
            {
              "user_condition": {
                "data.type_compte": "directeur"
              }
            }
          ]
        }
      }
    },
    "transfert_en_attente": {
      "default": false,
      "description": "True quand le dossier vient d'\u00eatre r\u00e9assign\u00e9 \u00e0 un autre agent ; repasse \u00e0 false \u00e0 la premi\u00e8re action du nouvel agent",
      "type": "boolean",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "data.type_compte": "agent"
              }
            },
            {
              "user_condition": {
                "data.type_compte": "directeur"
              }
            }
          ]
        }
      }
    },
    "date_premier_contact": {
      "description": "Horodatage du premier passage au statut contact\u00e9 (tracker)",
      "format": "date-time",
      "type": "string",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "data.type_compte": "agent"
              }
            },
            {
              "user_condition": {
                "data.type_compte": "directeur"
              }
            }
          ]
        }
      }
    }
  },
  "required": [
    "client_nom",
    "client_courriel",
    "priorite_urgence",
    "besoins_principaux",
    "consentement_explicite",
    "snapshot_profil"
  ],
  "rls": {
    "create": {},
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.agent_assigne_courriel": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.agent_assigne_courriel": "{{user.email}}"
        }
      ]
    }
  }
}